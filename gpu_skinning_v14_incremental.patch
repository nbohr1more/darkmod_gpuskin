diff --git a/renderer/backend/GpuParticles.cpp b/renderer/backend/GpuParticles.cpp
new file mode 100644
index 0000000..234acc5
--- /dev/null
+++ b/renderer/backend/GpuParticles.cpp
@@ -0,0 +1,354 @@
+/*****************************************************************************
+The Dark Mod GPL Source Code
+
