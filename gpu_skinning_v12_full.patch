+	// triangle lists of vertices (CSR)
+	std::vector<int> ownStart( numOut + 1, 0 );
+	for ( int i = 0; i < deformInfo->numIndexes; i++ ) {
+		ownStart[deformInfo->indexes[i] + 1]++;
+	}
+	for ( int i = 0; i < numOut; i++ ) {
+		ownStart[i + 1] += ownStart[i];
+	}
