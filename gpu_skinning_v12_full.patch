+void idMD5Mesh::BuildSkinnedVerts( int numJoints, const idJointMat *defaultPose, const idDrawVert *restVerts ) {
+	if ( deformInfo == NULL || numJoints > MAX_GPU_SKINNING_JOINTS || deformInfo->numOutputVerts <= 0 ) {
