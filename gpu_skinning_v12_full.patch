diff --git a/glprogs/stages/skinning/skin_direct.vert.glsl b/glprogs/stages/skinning/skin_direct.vert.glsl
new file mode 100644
index 0000000..d40ff98
--- /dev/null
+++ b/glprogs/stages/skinning/skin_direct.vert.glsl
@@ -0,0 +1,65 @@
+/*****************************************************************************
+The Dark Mod GPL Source Code
+
+This file is part of the The Dark Mod Source Code, originally based
+on the Doom 3 GPL Source Code as published in 2011.
+
+The Dark Mod Source Code is free software: you can redistribute it
+and/or modify it under the terms of the GNU General Public License as
+published by the Free Software Foundation, either version 3 of the License,
+or (at your option) any later version. For details, see LICENSE.TXT.
+
+Project: The Dark Mod (http://www.thedarkmod.com/)
+
+******************************************************************************/
+#version 330 core
+
+// GPU skinning for surfaces which are drawn without lighting (shadow maps, unlit materials):
+// only positions are needed, so skin them and write final idDrawVert (60 bytes) directly.
+// Normals and tangents are left as in rest pose and must not be used.
+
+in vec3 attr_WeightPos0;
+in vec3 attr_WeightPos1;
+in vec3 attr_WeightPos2;
+in vec3 attr_WeightPos3;
+in uvec4 attr_JointIndices;
+in vec4 attr_JointWeights;
+in vec2 attr_TexCoord;
+in vec4 attr_Color;
+in vec3 attr_Normal;
+in vec3 attr_Tangent;
+in vec3 attr_Bitangent;
+
+uniform samplerBuffer u_joints;		// all joint matrices of the frame: 3 texels (rows: xyz = rotation row, w = translation) per joint
+uniform isamplerBuffer u_instances;	// first joint of every instance (surface) in u_joints
+uniform int u_instanceBase;			// index of the first instance of this batch in u_instances
+
+// layout and order must match idDrawVert
+out vec3 tf_xyz;
+out vec2 tf_st;
+out vec3 tf_normal;
+out vec3 tf_tangent0;
+out vec3 tf_tangent1;
+flat out uint tf_color;
+
+vec3 skinWeight(int jointBase, int i, vec3 weightPos) {
+	float w = attr_JointWeights[i];
+	int j = (jointBase + int(attr_JointIndices[i])) * 3;
+	vec4 p = vec4(weightPos, 1.0);
+	return w * vec3(dot(texelFetch(u_joints, j + 0), p), dot(texelFetch(u_joints, j + 1), p), dot(texelFetch(u_joints, j + 2), p));
+}
+
+void main() {
+	int jointBase = texelFetch(u_instances, u_instanceBase + gl_InstanceID).x;
+	tf_xyz = skinWeight(jointBase, 0, attr_WeightPos0)
+		+ skinWeight(jointBase, 1, attr_WeightPos1)
+		+ skinWeight(jointBase, 2, attr_WeightPos2)
+		+ skinWeight(jointBase, 3, attr_WeightPos3);
+	tf_st = attr_TexCoord;
+	tf_normal = attr_Normal;
+	tf_tangent0 = attr_Tangent;
+	tf_tangent1 = attr_Bitangent;
+	uvec4 c = uvec4(clamp(attr_Color, 0.0, 1.0) * 255.0 + 0.5);
+	tf_color = c.x | (c.y << 8u) | (c.z << 16u) | (c.w << 24u);
+	gl_Position = vec4(0.0);
+}
diff --git a/glprogs/stages/skinning/skin_faces.vert.glsl b/glprogs/stages/skinning/skin_faces.vert.glsl
new file mode 100644
index 0000000..8fbd7ef
--- /dev/null
+++ b/glprogs/stages/skinning/skin_faces.vert.glsl
@@ -0,0 +1,85 @@
+/*****************************************************************************
+The Dark Mod GPL Source Code
+
+This file is part of the The Dark Mod Source Code, originally based
+on the Doom 3 GPL Source Code as published in 2011.
+
+The Dark Mod Source Code is free software: you can redistribute it
+and/or modify it under the terms of the GNU General Public License as
+published by the Free Software Foundation, either version 3 of the License,
+or (at your option) any later version. For details, see LICENSE.TXT.
+
+Project: The Dark Mod (http://www.thedarkmod.com/)
+
+******************************************************************************/
+#version 330 core
+
+// GPU skinning, pass 2 (per triangle): computes unit normal and unit tangents of every skinned triangle.
+// This is what idSIMD::DeriveTangents does per triangle on CPU. Results are gathered per vertex by pass 3
+// (skin_tangents.vert.glsl), so every triangle is computed only once instead of once per vertex.
+// Degenerate triangles give zero vectors, which contribute nothing to the sums.
+
+uniform samplerBuffer u_scratch;	// output of pass 1: two vec4 per vertex
+uniform isamplerBuffer u_indexes;	// three vertex indexes per triangle
+uniform int u_scratchBase;			// index of the first vertex of this batch in u_scratch
+uniform int u_numVerts;				// vertices per instance (instance k starts at u_scratchBase + k * u_numVerts)
+
+out vec4 tf_n;
+out vec4 tf_t0;
+out vec4 tf_t1;
+
+void getVert(int index, out vec3 pos, out vec2 st) {
+	int texel = (u_scratchBase + gl_InstanceID * u_numVerts + index) * 2;
+	vec4 a = texelFetch(u_scratch, texel);
+	vec4 b = texelFetch(u_scratch, texel + 1);
+	pos = a.xyz;
+	st = vec2(a.w, b.x);
+}
+
+void main() {
+	int tri = gl_VertexID;
+	int i0 = texelFetch(u_indexes, tri * 3 + 0).x;
+	int i1 = texelFetch(u_indexes, tri * 3 + 1).x;
+	int i2 = texelFetch(u_indexes, tri * 3 + 2).x;
+	vec3 pa, pb, pc;
+	vec2 sa, sb, sc;
+	getVert(i0, pa, sa);
+	getVert(i1, pb, sb);
+	getVert(i2, pc, sc);
+
+	vec3 d0 = pb - pa;
+	vec3 d1 = pc - pa;
+	vec2 e0 = sb - sa;
+	vec2 e1 = sc - sa;
+
+	vec3 n = vec3(0.0), t0 = vec3(0.0), t1 = vec3(0.0);
+
+	vec3 nn = vec3(
+		d1.y * d0.z - d1.z * d0.y,
+		d1.z * d0.x - d1.x * d0.z,
+		d1.x * d0.y - d1.y * d0.x
+	);
+	float nl = dot(nn, nn);
+	if (nl >= 1e-30) {
+		n = nn * inversesqrt(nl);
+
+		// sign of texture area
+		float area = e0.x * e1.y - e0.y * e1.x;
+		float sgn = (floatBitsToUint(area) >> 31u) != 0u ? -1.0 : 1.0;
+
+		vec3 tt0 = d0 * e1.y - d1 * e0.y;
+		float l0 = dot(tt0, tt0);
+		if (l0 > 1e-30)
+			t0 = tt0 * (inversesqrt(l0) * sgn);
+
+		vec3 tt1 = d1 * e0.x - d0 * e1.x;
+		float l1 = dot(tt1, tt1);
+		if (l1 > 1e-30)
+			t1 = tt1 * (inversesqrt(l1) * sgn);
+	}
+
+	tf_n = vec4(n, 0.0);
+	tf_t0 = vec4(t0, 0.0);
+	tf_t1 = vec4(t1, 0.0);
+	gl_Position = vec4(0.0);
+}
diff --git a/glprogs/stages/skinning/skin_positions.vert.glsl b/glprogs/stages/skinning/skin_positions.vert.glsl
new file mode 100644
index 0000000..8f07125
--- /dev/null
+++ b/glprogs/stages/skinning/skin_positions.vert.glsl
@@ -0,0 +1,55 @@
+/*****************************************************************************
+The Dark Mod GPL Source Code
+
+This file is part of the The Dark Mod Source Code, originally based
+on the Doom 3 GPL Source Code as published in 2011.
+
+The Dark Mod Source Code is free software: you can redistribute it
+and/or modify it under the terms of the GNU General Public License as
+published by the Free Software Foundation, either version 3 of the License,
+or (at your option) any later version. For details, see LICENSE.TXT.
+
+Project: The Dark Mod (http://www.thedarkmod.com/)
+
+******************************************************************************/
+#version 330 core
+
+// GPU skinning, pass 1: skins vertex positions of one MD5 mesh with transform feedback.
+// Exactly like MD5 CPU skinning: position = sum( weight_k * joint_k * offset_k ).
+// Since the joint matrices are (current joint) * (inverse default pose), every weight uses
+// the rest-pose position seen through that weight (attr_WeightPosK = default joint * offset).
+// Output is read by pass 2 (skin_tangents.vert.glsl) to derive normals/tangents from skinned triangles.
+
+in vec3 attr_WeightPos0;
+in vec3 attr_WeightPos1;
+in vec3 attr_WeightPos2;
+in vec3 attr_WeightPos3;
+in uvec4 attr_JointIndices;
+in vec4 attr_JointWeights;
+in vec2 attr_TexCoord;
+
+uniform samplerBuffer u_joints;		// all joint matrices of the frame: 3 texels (rows: xyz = rotation row, w = translation) per joint
+uniform isamplerBuffer u_instances;	// first joint of every instance (surface) in u_joints
+uniform int u_instanceBase;			// index of the first instance of this batch in u_instances
+
+out vec4 tf_a;	// position.xyz, st.x
+out vec4 tf_b;	// st.y, unused
+
+vec3 skinWeight(int jointBase, int i, vec3 weightPos) {
+	float w = attr_JointWeights[i];
+	int j = (jointBase + int(attr_JointIndices[i])) * 3;
+	vec4 p = vec4(weightPos, 1.0);
+	return w * vec3(dot(texelFetch(u_joints, j + 0), p), dot(texelFetch(u_joints, j + 1), p), dot(texelFetch(u_joints, j + 2), p));
+}
+
+void main() {
+	// instanced: one instance per surface, instances are written to the output one after another
+	int jointBase = texelFetch(u_instances, u_instanceBase + gl_InstanceID).x;
+	vec3 pos = skinWeight(jointBase, 0, attr_WeightPos0)
+		+ skinWeight(jointBase, 1, attr_WeightPos1)
+		+ skinWeight(jointBase, 2, attr_WeightPos2)
+		+ skinWeight(jointBase, 3, attr_WeightPos3);
+	tf_a = vec4(pos, attr_TexCoord.x);
+	tf_b = vec4(attr_TexCoord.y, 0.0, 0.0, 0.0);
+	gl_Position = vec4(0.0);
+}
diff --git a/glprogs/stages/skinning/skin_shadow.vert.glsl b/glprogs/stages/skinning/skin_shadow.vert.glsl
new file mode 100644
index 0000000..97f57cd
--- /dev/null
+++ b/glprogs/stages/skinning/skin_shadow.vert.glsl
@@ -0,0 +1,105 @@
+/*****************************************************************************
+The Dark Mod GPL Source Code
+
+This file is part of the The Dark Mod Source Code, originally based
+on the Doom 3 GPL Source Code as published in 2011.
+
+The Dark Mod Source Code is free software: you can redistribute it
+and/or modify it under the terms of the GNU General Public License as
+published by the Free Software Foundation, either version 3 of the License,
+or (at your option) any later version. For details, see LICENSE.TXT.
+
+Project: The Dark Mod (http://www.thedarkmod.com/)
+
+******************************************************************************/
+#version 330 core
+
+#pragma tdm_include "tdm_utils.glsl"
+
+// Stencil shadow volume of a GPU-skinned surface, generated from scratch by the vertex shader.
+// It does what R_CreateVertexProgramTurboShadowVolume does on CPU, but without any CPU work:
+//   * a quad (6 vertices) for every silhouette edge: the edge between a triangle facing the light and one that does not
+//   * for every triangle facing away from the light: a cap at its own position (6 vertices = 3 + 3 extruded to infinity)
+// The draw has no vertex attributes and no index buffer: gl_VertexID selects the edge or the triangle.
+// Edges which are not silhouettes and triangles facing the light become degenerate (zero-area) primitives.
+// Index and winding formulas are copied from the CPU code, vertex "idx" is: ( vertex << 1 ) | extrude.
+
+uniform mat4 u_projectionMatrix;
+uniform mat4 u_modelViewMatrix;
+uniform vec4 u_localLightOrigin;
+
+uniform samplerBuffer u_verts;		// dynamic vertex buffer as floats: skinned idDrawVert (15 floats per vertex)
+uniform isamplerBuffer u_silEdges;	// ivec4 per edge: triangle1, triangle2, vertex1, vertex2
+uniform isamplerBuffer u_indexes;	// triangle vertex indexes
+uniform int u_vertBase;				// index of the first float of the first vertex of the surface in u_verts
+uniform int u_numEdges;
+uniform int u_numTris;
+
+vec3 getPos(int v) {
+	int b = u_vertBase + v * 15;
+	return vec3(texelFetch(u_verts, b).x, texelFetch(u_verts, b + 1).x, texelFetch(u_verts, b + 2).x);
+}
+
+// the same as idPlane(v0, v1, v2).Distance(lightOrigin) >= 0 (only the sign matters, so no normalization)
+bool isFacing(int tri) {
+	if (tri >= u_numTris)
+		return true;	// dangling edge
+	vec3 p0 = getPos(texelFetch(u_indexes, tri * 3 + 0).x);
+	vec3 p1 = getPos(texelFetch(u_indexes, tri * 3 + 1).x);
+	vec3 p2 = getPos(texelFetch(u_indexes, tri * 3 + 2).x);
+	vec3 n = cross(p0 - p1, p2 - p1);
+	return dot(n, u_localLightOrigin.xyz - p1) >= 0.0;
+}
+
+vec4 shadowVertex(int idx) {
+	vec3 p = getPos(idx >> 1);
+	if ((idx & 1) != 0) {
+		// project vertex position to infinity
+		return vec4(p - u_localLightOrigin.xyz, 0.0);
+	}
+	return vec4(p, 1.0);
+}
+
+void main() {
+	int vid = gl_VertexID;
+	// degenerate by default
+	gl_Position = vec4(0.0);
+	int idx = -1;
+
+	if (vid < 6 * u_numEdges) {
+		int e = vid / 6;
+		int k = vid - e * 6;
+		ivec4 se = texelFetch(u_silEdges, e);
+		int f1 = isFacing(se.x) ? 1 : 0;
+		int f2 = isFacing(se.y) ? 1 : 0;
+		if (f1 != f2) {
+			int v1 = se.z << 1;
+			int v2 = se.w << 1;
+			if (k == 0) idx = v1;
+			else if (k == 1) idx = v2 ^ f1;
+			else if (k == 2) idx = v2 ^ f2;
+			else if (k == 3) idx = v1 ^ f2;
+			else if (k == 4) idx = v1 ^ f1;
+			else idx = v2 ^ 1;
+		}
+	} else {
+		int c = vid - 6 * u_numEdges;
+		int tri = c / 6;
+		int k = c - tri * 6;
+		if (tri < u_numTris && !isFacing(tri)) {
+			int i0 = texelFetch(u_indexes, tri * 3 + 0).x << 1;
+			int i1 = texelFetch(u_indexes, tri * 3 + 1).x << 1;
+			int i2 = texelFetch(u_indexes, tri * 3 + 2).x << 1;
+			if (k == 0) idx = i2;
+			else if (k == 1) idx = i1;
+			else if (k == 2) idx = i0;
+			else if (k == 3) idx = i0 ^ 1;
+			else if (k == 4) idx = i1 ^ 1;
+			else idx = i2 ^ 1;
+		}
+	}
+
+	if (idx >= 0) {
+		gl_Position = objectPosToClip(shadowVertex(idx), u_modelViewMatrix, u_projectionMatrix);
+	}
+}
diff --git a/glprogs/stages/skinning/skin_tangents.vert.glsl b/glprogs/stages/skinning/skin_tangents.vert.glsl
new file mode 100644
index 0000000..f6674f5
--- /dev/null
+++ b/glprogs/stages/skinning/skin_tangents.vert.glsl
@@ -0,0 +1,96 @@
+/*****************************************************************************
+The Dark Mod GPL Source Code
+
+This file is part of the The Dark Mod Source Code, originally based
+on the Doom 3 GPL Source Code as published in 2011.
+
+The Dark Mod Source Code is free software: you can redistribute it
+and/or modify it under the terms of the GNU General Public License as
+published by the Free Software Foundation, either version 3 of the License,
+or (at your option) any later version. For details, see LICENSE.TXT.
+
+Project: The Dark Mod (http://www.thedarkmod.com/)
+
+******************************************************************************/
+#version 330 core
+
+// GPU skinning, pass 3 (per vertex): builds final idDrawVert (60 bytes) of every vertex of an MD5 mesh with
+// transform feedback. Normals and tangents are gathered from the per-triangle results of pass 2
+// (skin_faces.vert.glsl), exactly like R_DeriveTangents does on CPU
+// (idSIMD::DeriveTangents + dup vertex normal merging + NormalizeTangents):
+//   * vertex sums unit normal and tangents of all triangles it belongs to
+//   * normal also adds the triangles of one "other" vertex with the same position (the dupVerts merge, including its
+//     asymmetric result for 3+ vertices at one position, see idMD5Mesh::BuildSkinnedVerts)
+//   * then the vectors are normalized and tangents are projected onto the normal plane
+// Triangle lists per vertex are precomputed on load (see idMD5Mesh::BuildSkinnedVerts).
+
+in vec2 attr_TexCoord;
+in vec4 attr_Color;
+in vec3 attr_Normal;		// rest pose, used only if vertex has no triangles
+in vec3 attr_Tangent;
+in vec3 attr_Bitangent;
+
+uniform samplerBuffer u_scratch;	// output of pass 1: two vec4 per vertex
+uniform isamplerBuffer u_vertInfo;	// ivec4 per vertex: (ownStart, ownCount, otherStart, otherCount) into u_lists
+uniform isamplerBuffer u_lists;		// triangle ids
+uniform samplerBuffer u_faces;		// output of pass 2: three vec4 per triangle (normal, tangent0, tangent1)
+uniform int u_scratchBase;			// index of the first vertex of this batch in u_scratch
+uniform int u_faceBase;				// index of the first triangle of this batch in u_faces
+uniform int u_numVerts;				// vertices per instance
+uniform int u_numTris;				// triangles per instance
+
+// layout and order must match idDrawVert
+out vec3 tf_xyz;
+out vec2 tf_st;
+out vec3 tf_normal;
+out vec3 tf_tangent0;
+out vec3 tf_tangent1;
+flat out uint tf_color;
+
+void main() {
+	int v = gl_VertexID;
+
+	int inst = gl_InstanceID;
+	vec3 pos = texelFetch(u_scratch, (u_scratchBase + inst * u_numVerts + v) * 2).xyz;
+
+	ivec4 info = texelFetch(u_vertInfo, v);
+	vec3 nSum = vec3(0.0), t0Sum = vec3(0.0), t1Sum = vec3(0.0);
+	for (int i = 0; i < info.y; i++) {
+		int face = (u_faceBase + inst * u_numTris + texelFetch(u_lists, info.x + i).x) * 3;
+		nSum += texelFetch(u_faces, face + 0).xyz;
+		t0Sum += texelFetch(u_faces, face + 1).xyz;
+		t1Sum += texelFetch(u_faces, face + 2).xyz;
+	}
+	// triangles of the other vertex at the same position (only normals are merged between them)
+	for (int i = 0; i < info.w; i++) {
+		int face = (u_faceBase + inst * u_numTris + texelFetch(u_lists, info.z + i).x) * 3;
+		nSum += texelFetch(u_faces, face + 0).xyz;
+	}
+
+	vec3 n = attr_Normal;
+	float nl = dot(nSum, nSum);
+	if (nl > 1e-30)
+		n = nSum * inversesqrt(nl);
+
+	vec3 t0 = attr_Tangent;
+	t0Sum -= dot(t0Sum, n) * n;
+	float l0 = dot(t0Sum, t0Sum);
+	if (l0 > 1e-30)
+		t0 = t0Sum * inversesqrt(l0);
+
+	vec3 t1 = attr_Bitangent;
+	t1Sum -= dot(t1Sum, n) * n;
+	float l1 = dot(t1Sum, t1Sum);
+	if (l1 > 1e-30)
+		t1 = t1Sum * inversesqrt(l1);
+
+	tf_xyz = pos;
+	tf_st = attr_TexCoord;
+	tf_normal = n;
+	tf_tangent0 = t0;
+	tf_tangent1 = t1;
+	// byte color (little endian: color[0] is the lowest byte)
+	uvec4 c = uvec4(clamp(attr_Color, 0.0, 1.0) * 255.0 + 0.5);
+	tf_color = c.x | (c.y << 8u) | (c.z << 16u) | (c.w << 24u);
+	gl_Position = vec4(0.0);
+}
diff --git a/idlib/geometry/DrawVert.h b/idlib/geometry/DrawVert.h
index b415f40..f329e43 100644
--- a/idlib/geometry/DrawVert.h
+++ b/idlib/geometry/DrawVert.h
@@ -59,6 +59,35 @@ ID_FORCE_INLINE float	&idDrawVert::operator[]( const int index ) {
 	return ((float *)(&xyz))[index];
 }
 
+/*
+===============================================================================
+
+	Skinned Draw Vertex (GPU skinning)
+
+	Rest-pose idDrawVert at full float precision, followed by joint indices and
+	joint weights used by the vertex shader to blend joint matrices.
+	Position, normal and tangents are in the default (bind) pose.
+	Layout is a strict superset of idDrawVert, so an unskinned shader can read it.
+
+===============================================================================
+*/
+class idDrawVertSkinned {
+public:
+	idDrawVert		vert;				// 60 bytes, rest pose
+	byte			jointIndices[4];	// 4 bytes, unused entries have zero weight
+	float			jointWeights[4];	// 16 bytes, MD5 weights (sum ~1.0), zero for unused entries
+	// Rest-pose position as seen through each weight: (default pose of joint k) * (MD5 weight offset k).
+	// The shader computes sum_k( w_k * skinMatrix_k * weightPos[k] ), which is exactly the MD5 formula
+	// sum_k( w_k * currentJoint_k * offset_k ), since skinMatrix = currentJoint * inverse(defaultPose).
+	idVec3			weightPos[4];		// 48 bytes
+};
+static_assert( sizeof( idDrawVertSkinned ) == sizeof( idDrawVert ) + 4 + 16 + 48, "idDrawVertSkinned must have no padding" );
+
+// maximum number of joints addressable by the byte joint index and the joint uniform block
+const int MAX_GPU_SKINNING_JOINTS = 256;
+// number of vec4 rows per joint (3x4 matrix)
+const int GPU_SKINNING_ROWS_PER_JOINT = 3;
+
 ID_INLINE void idDrawVert::Clear( void ) {
 	xyz.Zero();
 	st.Zero();
diff --git a/renderer/RenderSystem_init.cpp b/renderer/RenderSystem_init.cpp
index 17d069f..9561cc9 100644
