diff --git a/renderer/RenderSystem_init.cpp b/renderer/RenderSystem_init.cpp
index 9561cc9..d38b971 100644
--- a/renderer/RenderSystem_init.cpp
+++ b/renderer/RenderSystem_init.cpp
@@ -53,6 +53,7 @@ idCVar r_useShadowSurfaceScissor( "r_useShadowSurfaceScissor", "1", CVAR_RENDERE
 idCVar r_useInteractionTable( "r_useInteractionTable", "2", CVAR_RENDERER | CVAR_INTEGER, "which implementation to use for table of existing interactions: 0 = none, 1 = single full matrix, 2 = single hash table" );
 idCVar r_useTurboShadow( "r_useTurboShadow", "1", CVAR_RENDERER | CVAR_BOOL, "use the infinite projection with W technique for dynamic shadows" );
 idCVar r_useDeferredTangents( "r_useDeferredTangents", "1", CVAR_RENDERER | CVAR_BOOL, "defer tangents calculations after deform" );
+idCVar r_skinGpuLightCull( "r_skinGpuLightCull", "0", CVAR_RENDERER | CVAR_BOOL | CVAR_ARCHIVE, "experimental: GPU-skinned surfaces are lit with all their triangles instead of CPU per-triangle light culling (saves CPU positions/cull bits work). Best with r_skinLazyPositions 1" );
 idCVar r_skinGpuShadows( "r_skinGpuShadows", "0", CVAR_RENDERER | CVAR_BOOL | CVAR_ARCHIVE, "experimental: stencil shadow volumes of GPU-skinned models are generated on the GPU (no CPU facing/silhouette work). Best with r_skinLazyPositions 1" );
 idCVar r_skinLazyPositions( "r_skinLazyPositions", "0", CVAR_RENDERER | CVAR_BOOL | CVAR_ARCHIVE, "experimental: with r_useGPUSkinning, do not skin vertex positions on CPU every frame. Surface bounds come from per-joint bounds, and positions are skinned only when shadows, light culling, traces, decals, deforms etc. ask for them." );
 idCVar r_skinTimers( "r_skinTimers", "0", CVAR_RENDERER | CVAR_INTEGER, "print skinning timings (CPU and GPU) to the console, averaged over this many frames; 0 = off" );
diff --git a/renderer/frontend/Interaction.cpp b/renderer/frontend/Interaction.cpp
index 647b9a4..21b06e4 100644
--- a/renderer/frontend/Interaction.cpp
+++ b/renderer/frontend/Interaction.cpp
@@ -328,7 +328,11 @@ static srfTriangles_t *R_CreateLightTris( const idRenderEntityLocal *ent,
         const idMaterial *shader, srfCullInfo_t &cullInfo
 ) {
 	TRACE_CPU_SCOPE("R_CreateLightTris");
-	R_EnsureSkinnedPositions( tri );
+	// r_skinGpuLightCull: don't touch the vertices of GPU-skinned surface at all, light it with all its triangles
+	// (superset of what culling would give: scissor and depth bounds still limit the lit pixels)
+	const bool skipCulling = r_skinGpuLightCull.GetBool() && tri->skinJoints != NULL && tri->skinnedSource.IsSkinnedBuffer();
+	if ( !skipCulling )
+		R_EnsureSkinnedPositions( tri );
 	SkinScopeTimer skinTimer( skinTimers.lightTrisNs, tri->deformedSurface && r_skinTimers.GetInteger() > 0 );
 
 	int			i;
@@ -364,6 +368,13 @@ static srfTriangles_t *R_CreateLightTris( const idRenderEntityLocal *ent,
 	newTri->numVerts = tri->numVerts;
 	R_ReferenceStaticTriSurfVerts( newTri, tri );
 
+	if ( skipCulling ) {
+		newTri->numIndexes = tri->numIndexes;
+		R_ReferenceStaticTriSurfIndexes( newTri, tri );
+		newTri->bounds = tri->bounds;
+		return newTri;
+	}
+
 	if ( r_modelBvhLightTris.GetInteger() > 0 && tri->bvhNodes && tri->numIndexes / 3 > r_modelBvhLightTrisGranularity.GetInteger() ) {
 		// stgatilov #5886: BVH-optimized culling by light volume and facing
 		return R_FinishLightTrisWithBvh( ent, light, tri, newTri, includeBackFaces );
